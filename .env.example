# Security settings
SECRET_KEY=generate_a_strong_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Default uses SQLite, uncomment for PostgreSQL)
# DATABASE_URL=postgres://user:password@localhost:5432/mova_db

# Redis settings for Channels/Celery
# REDIS_URL=redis://127.0.0.1:6379

# JWT
# JWT_SIGNING_KEY=your_separate_jwt_signing_key

# Production flags
# SECURE_SSL_REDIRECT=True
